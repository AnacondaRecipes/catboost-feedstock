From df18e62abfb207e6f2d249dbf4652bfe42eac54d Mon Sep 17 00:00:00 2001
From: Andrii Osipov <aosipov@anaconda.com>
Date: Tue, 23 Jun 2026 00:21:02 -0700
Subject: [PATCH] Remove SME/BFloat16 builtins and compiler-specific settings
 incompatible with older CUDA toolchains

This patch adapts CatBoost's CMake build system to work with system-provided
toolchains and OpenSSL, and removes compiler-runtime builtins that are
incompatible with older CUDA/clang versions.

Conan's FindOpenSSL.cmake exposes `openssl::openssl` while CMake's built-in
exposes `OpenSSL::SSL` / `OpenSSL::Crypto`. A bridge ALIAS target
`LinkOpenSSL` reconciles the naming difference so downstream targets work
without modification.
See: https://github.com/conan-io/conan-center-index/issues/952

 - Removed explicit `CMAKE_C_COMPILER=clang` / `CMAKE_CXX_COMPILER=clang++`
  and `ENV{CC}` / `ENV{CXX}` assignments to allow the caller to supply
  the compiler (e.g. via conda build environment).
 - Removed `CMAKE_CUDA_HOST_COMPILER=clang-14` to avoid pinning to a
  specific clang version.

  (catboost/python-package/pyproject.toml, setup.py)
`cmake` and `conan` are no longer required as Python build-time dependencies
since the build system is now driven externally (e.g. conda-build).

  (contrib/libs/cxxsupp/CMakeLists.linux-{x86_64,aarch64,ppc64le}.txt)
 - clang < 18: use `libcxxcuda11` (CUDA 11 compatible libc++)
 - clang >= 18: use standard `libcxx`
Applies to all three Linux architectures: x86_64, aarch64, ppc64le.

  (contrib/libs/cxxsupp/builtins/CMakeLists.linux-aarch64{,-cuda}.txt)
Removed source files incompatible with older clang/CUDA toolchains:
 - BFloat16 conversion builtins: extendbfsf2.c, truncdfbf2.c, truncsfbf2.c,
  truncxfbf2.c, trunctfbf2.c
 - ARM SME (Scalable Matrix Extension) builtins: sme-abi.S, sme-abi-assert.c,
  sme-libc-mem-routines.S, sme-libc-routines.c, chkstk.S
These features require clang >= 17 and are not available in CUDA 11
toolchains.
---
 CMakeLists.txt                                  | 11 +++++++++++
 build/toolchains/clang.toolchain                |  6 ------
 catboost/python-package/pyproject.toml          |  2 --
 catboost/python-package/setup.py                |  2 +-
 .../libs/cxxsupp/CMakeLists.linux-aarch64.txt   | 17 +++++++++++++++--
 .../libs/cxxsupp/CMakeLists.linux-ppc64le.txt   | 17 +++++++++++++++--
 .../libs/cxxsupp/CMakeLists.linux-x86_64.txt    | 17 +++++++++++++++--
 .../builtins/CMakeLists.linux-aarch64-cuda.txt  | 10 ----------
 .../builtins/CMakeLists.linux-aarch64.txt       | 10 ----------
 9 files changed, 57 insertions(+), 35 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 93f044a1..44a625b0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -19,6 +19,17 @@ endif()
 
 project(CATBOOST LANGUAGES C CXX ASM)
 
+# Use OpenSSL from system instead of the version provided by conan.
+#  1. conan supplied FindOpenSSL.cmake provides openssl::openssl
+#  2. cmake supplied FindOpenSSL.cmake provides OpenSSL::SSL and OpenSSL::Crypto.
+# See https://github.com/conan-io/conan-center-index/issues/952
+# This patch is needed to reconcile the difference.
+find_package(OpenSSL REQUIRED)
+include_directories(${OPENSSL_INCLUDE_DIR})
+add_library(LinkOpenSSL INTERFACE)
+target_link_libraries(LinkOpenSSL INTERFACE OpenSSL::SSL OpenSSL::Crypto)
+add_library(openssl::openssl ALIAS LinkOpenSSL)
+
 set(BUILD_SHARED_LIBS Off)
 set(CMAKE_CXX_STANDARD 20)
 set(CMAKE_CXX_EXTENSIONS Off)
diff --git a/build/toolchains/clang.toolchain b/build/toolchains/clang.toolchain
index c5a3fe75..34513cc8 100644
--- a/build/toolchains/clang.toolchain
+++ b/build/toolchains/clang.toolchain
@@ -1,11 +1,7 @@
-set(CMAKE_C_COMPILER clang)
-set(CMAKE_CXX_COMPILER clang++)
-
 set(CMAKE_C_STANDARD_LIBRARIES "-lc -lm")
 set(CMAKE_CXX_STANDARD_LIBRARIES "-lc -lm")
 
 set(CMAKE_CUDA_COMPILER nvcc)
-set(CMAKE_CUDA_HOST_COMPILER clang-14)
 
 set(CMAKE_CUDA_FLAGS_INIT "--allow-unsupported-compiler")
 
@@ -14,8 +10,6 @@ if (NOT APPLE)
   set(CMAKE_SHARED_LINKER_FLAGS -fuse-ld=lld)
 endif()
 
-set(ENV{CC} clang)
-set(ENV{CXX} clang++)
 set(ENV{NVCC_PREPEND_FLAGS} "--allow-unsupported-compiler -std=c++17")
 
 set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
diff --git a/catboost/python-package/pyproject.toml b/catboost/python-package/pyproject.toml
index 588bf56b..2d46df10 100644
--- a/catboost/python-package/pyproject.toml
+++ b/catboost/python-package/pyproject.toml
@@ -2,9 +2,7 @@
 build-backend = "setuptools.build_meta"
 requires = [
     "setuptools (>=70.1.0, <83.0)",
-    "cmake (>=3.24, <4.0)",
     "jupyterlab (>=3.0.6, <3.6.0)",
-    "conan (>=2.4.1, <3.0)",
     "cython ~= 3.0.10",
     "numpy < 3.0"
 ]
diff --git a/catboost/python-package/setup.py b/catboost/python-package/setup.py
index b4c1890b..3f9b3d7f 100644
--- a/catboost/python-package/setup.py
+++ b/catboost/python-package/setup.py
@@ -124,7 +124,7 @@ def setup_hnsw_submodule(argv, extensions):
 
 
 def get_setup_requires(argv):
-    setup_requires = ['cmake (>=3.24, <4.0)', 'conan (>=2.4.1, <3.0)', 'cython ~= 3.0.10', 'numpy < 3.0']
+    setup_requires = ['conan (>=2.4.1, <3.0)', 'cython ~= 3.0.10', 'numpy < 3.0']
 
     if ('build_widget' in argv) or (not ('--no-widget' in argv)):
         setup_requires += ['jupyterlab (>=3.0.6, <3.6.0)']
